---
layout: base.njk
title: "Articles"
description: "All articles with filtering by tags."
pagination:
  data: collections.articles
  size: 1000
  alias: items
---



<div class="tag-filter">
  <details class="tag-filter-details">
    <summary class="tag-filter-summary">
      <h3>Filter by tag:</h3>
      <span class="tag-count"></span>
    </summary>
    <div class="tag-list">
      {% set allTags = [] %}
      {% for post in collections.articles %}
        {% if post.data.tags %}
          {% for tag in post.data.tags %}
            {% set allTags = (allTags.push(tag), allTags) %}
          {% endfor %}
        {% endif %}
      {% endfor %}
      {% set uniqueTags = allTags | unique | sort %}
      
      {% for tag in uniqueTags %}
        <a href="/tags/{{ tag | slugify }}/" class="tag tag-filter-link">{{ tag }}</a>
      {% endfor %}
    </div>
  </details>
</div>

<ul class="posts-list" role="list">
{% for post in items %}
  <li class="post-item">
    <a href="{{ post.url }}" class="post-link">
      <h3>{{ post.data.title }}</h3>
      <p class="post-meta">
        <time datetime="{{ post.date | dateISO }}">{{ post.date | dateISO }}</time>
        {% if post.data.tags %}
          <span class="post-tags">
            {% for t in post.data.tags %}<span class="tag">{{ t }}</span>{% endfor %}
          </span>
        {% endif %}
      </p>
      {% if post.data.description %}<p class="post-description">{{ post.data.description }}</p>{% endif %}
    </a>
  </li>
{% endfor %}
</ul>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Update tag count in the collapsible filter
  const tagCount = document.querySelector('.tag-count');
  const tagLinks = document.querySelectorAll('.tag-filter-link');
  
  if (tagCount && tagLinks.length > 0) {
    tagCount.textContent = `${tagLinks.length} tags`;
  }
  
  // Add smooth animation to the collapsible filter
  const details = document.querySelector('.tag-filter-details');
  if (details) {
    details.addEventListener('toggle', function() {
      const summary = this.querySelector('.tag-filter-summary');
      if (this.open) {
        summary.style.borderBottom = '1px solid var(--border)';
      } else {
        summary.style.borderBottom = 'none';
      }
    });
  }
});
</script>
