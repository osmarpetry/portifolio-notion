---
permalink: /feed.xml
eleventyExcludeFromCollections: true
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}"/>
  {% set latest = collections.articles | first %}
  <updated>{% if latest %}{{ latest.date | date | dateISO }}{% else %}{{ "now" | date | dateISO }}{% endif %}</updated>
  <id>{{ site.url }}/</id>
  {% for post in collections.articles %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <updated>{{ post.date | date | dateISO }}</updated>
    <summary>{{ post.data.description or "" }}</summary>
  </entry>
  {% endfor %}
</feed>
