</head>
<body>
  <!-- Theme switcher -->
  <div class="theme-switcher">
    <button id="theme-toggle" aria-label="Toggle theme">
      <span class="theme-icon">🌙</span>
    </button>
  </div>
  
  <!-- Scroll to top button -->
  <button id="scroll-to-top" aria-label="Scroll to top">↑</button>
  
  <div class="wrap">
    {% if page.url != "/" %}
    <header>
      <div>
        <a href="/"><strong>{{ site.title }}</strong></a>
        <div class="muted">Senior Software Engineer — React · TS · Node · AWS/GCP</div>
      </div>
    </header>
    {% endif %}

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <small class="muted">© {{ "now" | date | dateISO }} {{ site.title }}</small>
      <a href="/articles/">Articles</a>
    </footer>
  </div>

  <!-- Theme switcher script -->
  <script>
    (function() {
      const themeToggle = document.getElementById('theme-toggle');
      const bodyElement = document.body;
      const htmlElement = document.documentElement;
      const themeIcon = document.querySelector('.theme-icon');
      
      if (!themeToggle) {
        console.error('Theme toggle button not found');
        return;
      }

      function applyTheme(theme) {
        console.log('Applying theme:', theme);
        
        // Remove both classes first
        bodyElement.classList.remove('dark', 'light');
        htmlElement.classList.remove('dark', 'light');
        
        // Add the appropriate class
        if (theme === 'dark') {
          bodyElement.classList.add('dark');
          htmlElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
          if (themeIcon) themeIcon.textContent = '☀️';
        } else {
          bodyElement.classList.add('light');
          htmlElement.classList.add('light');
          localStorage.setItem('theme', 'light');
          if (themeIcon) themeIcon.textContent = '🌙';
        }
        
        console.log('Theme applied. Body classes:', bodyElement.className);
      }

      // Initialize theme on page load
      document.addEventListener('DOMContentLoaded', function() {
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        let initialTheme;
        if (storedTheme) {
          initialTheme = storedTheme;
        } else {
          initialTheme = prefersDark ? 'dark' : 'light';
        }
        
        console.log('Initial theme:', initialTheme, 'Stored:', storedTheme, 'System prefers dark:', prefersDark);
        applyTheme(initialTheme);
      });

      // Toggle theme on click
      themeToggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const isDark = bodyElement.classList.contains('dark');
        const newTheme = isDark ? 'light' : 'dark';
        
        console.log('Toggling from', (isDark ? 'dark' : 'light'), 'to', newTheme);
        applyTheme(newTheme);
      });

      // Listen for system theme changes
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
        if (!localStorage.getItem('theme')) {
          applyTheme(e.matches ? 'dark' : 'light');
        }
      });
    })();
  </script>

  <!-- Scroll to top functionality -->
  <script>
    (function() {
      const scrollToTopBtn = document.getElementById('scroll-to-top');
      let scrollTimeout;
      let isVisible = false;
      
      if (!scrollToTopBtn) return;

      function showButton() {
        if (!isVisible) {
          scrollToTopBtn.classList.add('show');
          isVisible = true;
        }
        
        // Clear existing timeout
        clearTimeout(scrollTimeout);
        
        // Set timeout to hide after 5 seconds of no scrolling
        scrollTimeout = setTimeout(() => {
          hideButton();
        }, 5000);
      }

      function hideButton() {
        if (isVisible) {
          scrollToTopBtn.classList.remove('show');
          isVisible = false;
        }
        clearTimeout(scrollTimeout);
      }

      function scrollToTop() {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
        hideButton();
      }

      // Show/hide button based on scroll position
      window.addEventListener('scroll', function() {
        if (window.pageYOffset > 300) {
          showButton();
        } else {
          hideButton();
        }
      });

      // Click handler
      scrollToTopBtn.addEventListener('click', scrollToTop);
    })();
  </script>

  <!-- Homepage section links script -->
  {% if page.url == "/" %}
  <script>
    (function() {
      // Add section link functionality to homepage headings
      document.addEventListener('DOMContentLoaded', function() {
        const headings = document.querySelectorAll('#about h1, #experience h2, #experience h3, #experience p[id]');
        
        headings.forEach(heading => {
          if (heading.id || heading.parentElement.id) {
            const targetId = heading.id || heading.parentElement.id;
            
            // Make entire heading clickable
            heading.style.position = 'relative';
            heading.style.cursor = 'pointer';
            heading.title = 'Click to copy section link';
            
            // Create section link button (visual indicator)
            const linkBtn = document.createElement('button');
            linkBtn.className = 'section-link';
            linkBtn.innerHTML = '🔗';
            linkBtn.title = 'Copy section link';
            linkBtn.setAttribute('aria-label', 'Copy section link');
            heading.appendChild(linkBtn);
            
            // Function to copy link and scroll
            async function copyLinkAndScroll(e) {
              e.preventDefault();
              e.stopPropagation();
              
              const url = `${window.location.origin}${window.location.pathname}#${targetId}`;
              
              // Smooth scroll to section
              const targetElement = document.getElementById(targetId) || heading;
              if (targetElement) {
                targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
                // Update URL without page reload
                window.history.pushState(null, null, `#${targetId}`);
              }
              
              try {
                await navigator.clipboard.writeText(url);
                linkBtn.innerHTML = '✓';
                linkBtn.style.color = 'var(--primary)';
                setTimeout(() => {
                  linkBtn.innerHTML = '🔗';
                  linkBtn.style.color = '';
                }, 2000);
              } catch (err) {
                console.error('Failed to copy link:', err);
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = url;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                
                linkBtn.innerHTML = '✓';
                linkBtn.style.color = 'var(--primary)';
                setTimeout(() => {
                  linkBtn.innerHTML = '🔗';
                  linkBtn.style.color = '';
                }, 2000);
              }
            }
            
            // Add click handler to entire heading
            heading.addEventListener('click', copyLinkAndScroll);
            
            // Add click handler to button (prevent double execution)
            linkBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              copyLinkAndScroll(e);
            });
          }
        });
      });
    })();
  </script>
  {% endif %}
</body>
</html>
